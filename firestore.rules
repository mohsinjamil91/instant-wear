rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the owner's User UID from Firebase Authentication.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'CLrkyDvHQxVYlwJ4eVUCpPP6Mfs1';
    }

    function validOrder() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','code','name','phone','addr','pin','items','sub','fee','total','status','at','etaAt'])
        && d.status == 'Placed'
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.phone is string && d.phone.size() == 10
        && d.addr is string && d.addr.size() >= 8 && d.addr.size() <= 200
        && d.pin is string && d.pin.size() == 6
        && d.items is list && d.items.size() > 0 && d.items.size() <= 30
        && d.total is number && d.total > 0 && d.total < 100000;
    }

    // Everyone can see the clothes. Only the owner can change them.
    match /products/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Customers place an order and can read it back by its long random id.
    // Only the owner can list, edit or delete orders.
    match /orders/{id} {
      allow get: if true;
      allow create: if validOrder();
      allow list, update, delete: if isOwner();
    }
  }
}
